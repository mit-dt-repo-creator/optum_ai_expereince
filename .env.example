# GECX virtual agent launch links
# ------------------------------------------------------------------
# Copy this file to `.env.local` and paste the launch URLs for your
# existing GECX virtual agents. Each value must be a full https:// URL.
# Leave a value empty and that button will show as "not configured".
#
# If one agent serves several categories, paste the same URL in each.
#
# IMPORTANT: every VITE_* value is compiled into the public JavaScript
# bundle. Put launch URLs only here. Never put API keys, tokens, client
# secrets or other credentials in this file.

VITE_GECX_PAYER_VOICE_URL=
VITE_GECX_PAYER_CHAT_URL=

VITE_GECX_PROVIDER_VOICE_URL=
VITE_GECX_PROVIDER_CHAT_URL=

VITE_GECX_LIFE_SCIENCES_VOICE_URL=
VITE_GECX_LIFE_SCIENCES_CHAT_URL=
